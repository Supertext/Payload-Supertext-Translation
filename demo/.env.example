# Copy to .env for local runs. Never commit real values.
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Postgres. The database is created on first start if it doesn't exist.
# Local Postgres: docker compose up -d (see docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/payload_demo

# Supertext AI translation
# No Supertext account yet? Create one at https://www.supertext.com/person/en/account/signin
# Generate the key at supertext.com -> Integrations -> API (requires the Admin role):
# https://www.supertext.com/en/integrations/api
SUPERTEXT_API_KEY=
# live (default), staging or testing
SUPERTEXT_ENVIRONMENT=live
# Optional: explicit API base URL (e.g. a local fake for testing), overrides SUPERTEXT_ENVIRONMENT
# SUPERTEXT_API_URL=http://localhost:4010/v1/
# Optional: another review service for locales with "Translation review" ticked in Supertext settings
# (default: Supertext's review service)
# SUPERTEXT_REVIEW_URL=http://localhost:3000/v1/
# "Send version information to Supertext" (site URL and plugin/Payload/Node.js versions, no content,
# no API key, no personal data). On by default; 0 turns it off.
# SUPERTEXT_VERSION_REPORTS=0

# Optional: demo accounts, created on every start if they don't exist yet (existing accounts are never changed).
# Without these, Payload asks you to create the first user in the browser.
# PAYLOAD_ADMIN_EMAIL / PAYLOAD_ADMIN_PASSWORD still work as fallbacks for DEMO_ADMIN_*.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Second account, e.g. for automated tests (same access as the admin; the demo has no roles)
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=
